{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "edict2077",
  "server": {
    "dir": "distribution/server",
    "entry": "Bootstrap.cjs"
  },
  "post": {
    "entrypoints": {
      "default": {
        "entry": "distribution/customposts/Index.js",
        "height": "tall"
      }
    }
  },
  "permissions": {
    "reddit": {
      "enable": true
    },
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["api.openai.com", "generativelanguage.googleapis.com"]
    }
  },
  "settings": {
    "global": {
      "compilerProvider": {
        "type": "select",
        "label": "Compiler provider",
        "options": [
          {
            "label": "OpenAI · GPT (recommended for best schema fidelity)",
            "value": "openai"
          },
          {
            "label": "Gemini · Google (free tier available)",
            "value": "gemini"
          }
        ],
        "defaultValue": "openai",
        "helpText": "Both providers are on Reddit's approved AI provider list (PR #96). Set the matching API key in the corresponding secret below."
      },
      "openaiApiKey": {
        "type": "string",
        "label": "OpenAI API key (sk-â€¦)",
        "isSecret": true,
        "helpText": "EDICT only calls the model at rule-edit time (never on user content). Set after first upload: `npm run secret:openai`. Used when compilerProvider = openai."
      },
      "geminiApiKey": {
        "type": "string",
        "label": "Gemini API key (AIzaâ€¦)",
        "isSecret": true,
        "helpText": "Google AI Studio key. EDICT only calls the model at rule-edit time. Set with `npm run secret:gemini`. Used when compilerProvider = gemini."
      },
      "compilerModel": {
        "type": "select",
        "label": "Compiler model",
        "options": [
          {
            "label": "gpt-5.4-mini · OpenAI · recommended · fast & accurate",
            "value": "gpt-5.4-mini"
          },
          {
            "label": "gpt-5.4-nano · OpenAI · cheapest",
            "value": "gpt-5.4-nano"
          },
          {
            "label": "gpt-5.4 · OpenAI · most cautious about ambiguity",
            "value": "gpt-5.4"
          },
          {
            "label": "gemini-2.5-flash · Google · fast, free-tier friendly",
            "value": "gemini-2.5-flash"
          },
          {
            "label": "gemini-2.5-flash-lite · Google · cheapest",
            "value": "gemini-2.5-flash-lite"
          },
          {
            "label": "gemini-2.5-pro · Google · most cautious about ambiguity",
            "value": "gemini-2.5-pro"
          }
        ],
        "defaultValue": "gpt-5.4-mini",
        "helpText": "Pick a model that matches your compilerProvider. Mixing (e.g. provider=gemini, model=gpt-5.4) will fail."
      },
      "compilerVerbosity": {
        "type": "select",
        "label": "Compiler ambiguity tolerance",
        "options": [
          {
            "label": "Strict â€” always ask if unclear",
            "value": "strict"
          },
          {
            "label": "Balanced â€” ask only on high-stakes actions",
            "value": "balanced"
          },
          {
            "label": "Permissive â€” best-guess for trivial rules",
            "value": "permissive"
          }
        ],
        "defaultValue": "balanced"
      }
    },
    "subreddit": {
      "sandboxMode": {
        "type": "boolean",
        "label": "Subreddit-wide kill switch (rules log decisions, never act)",
        "defaultValue": true
      },
      "adaptiveShadow": {
        "type": "boolean",
        "label": "Adaptive shadow â€” auto-promote a rule when confidence is high (vs fixed-time)",
        "defaultValue": true
      },
      "shadowConfidenceThreshold": {
        "type": "number",
        "label": "Adaptive shadow promote threshold (0â€“1)",
        "validationEndpoint": "/internal/validate/confidence",
        "defaultValue": 0.92
      },
      "shadowMinObservations": {
        "type": "number",
        "label": "Minimum observations before adaptive promote",
        "validationEndpoint": "/internal/validate/observations",
        "defaultValue": 25
      },
      "shadowMaxHours": {
        "type": "number",
        "label": "Hard cap on shadow duration (hours, fallback if adaptive never trips)",
        "validationEndpoint": "/internal/validate/duration",
        "defaultValue": 72
      },
      "perRuleActionCeiling": {
        "type": "number",
        "label": "Per-rule action ceiling per hour (auto-pause if exceeded)",
        "validationEndpoint": "/internal/validate/ceiling",
        "defaultValue": 50
      },
      "subwideActionCeiling": {
        "type": "number",
        "label": "Subreddit-wide action ceiling per hour (master brake)",
        "validationEndpoint": "/internal/validate/ceiling",
        "defaultValue": 200
      },
      "rolloutPercent": {
        "type": "number",
        "label": "Staged rollout â€” match this % of eligible content while ramping (0â€“100)",
        "validationEndpoint": "/internal/validate/rollout",
        "defaultValue": 100
      },
      "consensusRequired": {
        "type": "select",
        "label": "Mod consensus required for high-impact rules",
        "options": [
          {
            "label": "Off â€” single mod can activate any rule",
            "value": "off"
          },
          {
            "label": "Risky-only â€” bans/removals need 2 mod approvals",
            "value": "risky"
          },
          {
            "label": "Strict â€” every activation needs 2 mod approvals",
            "value": "strict"
          }
        ],
        "defaultValue": "risky"
      },
      "rollbackWindowDays": {
        "type": "number",
        "label": "Rollback window per action (days)",
        "validationEndpoint": "/internal/validate/window",
        "defaultValue": 30
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "EDICT · Open Command Center",
        "description": "Active rules, audit timeline, effectiveness, what-if simulator, gallery, briefing â€” all tabs.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/open-command-center"
      },
      {
        "label": "EDICT · Compose new rule",
        "description": "Write a multi-clause rule in plain English.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/compose-edict"
      },
      {
        "label": "EDICT · Activate LIVE",
        "description": "Activate the most-recently composed draft in LIVE phase (skips shadow). Use for demos.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/activate-latest-live"
      },
      {
        "label": "EDICT · Reverse this decision",
        "description": "Restore the post/comment (within rollback window).",
        "forUserType": "moderator",
        "location": ["post", "comment"],
        "endpoint": "/internal/menu/reverse-decision"
      },
      {
        "label": "EDICT · Explain this decision",
        "description": "Show the rule clauses and fact-bag values that fired.",
        "forUserType": "moderator",
        "location": ["post", "comment"],
        "endpoint": "/internal/menu/explain-decision"
      }
    ]
  },
  "forms": {
    "composeForm": "/internal/form/compose-submit",
    "clarifyForm": "/internal/form/clarify-submit",
    "activateForm": "/internal/form/activate-submit",
    "whatIfForm": "/internal/form/whatif-submit",
    "consensusForm": "/internal/form/consensus-vote",
    "galleryForm": "/internal/form/gallery-import"
  },
  "triggers": {
    "onPostSubmit": "/internal/trigger/post-submitted",
    "onCommentSubmit": "/internal/trigger/comment-submitted",
    "onPostReport": "/internal/trigger/post-reported",
    "onCommentReport": "/internal/trigger/comment-reported",
    "onPostFlairUpdate": "/internal/trigger/flair-changed",
    "onAppInstall": "/internal/trigger/app-installed",
    "onAppUpgrade": "/internal/trigger/app-upgraded"
  },
  "scheduler": {
    "tasks": {
      "shadow-promotion-sweep": {
        "endpoint": "/internal/scheduler/shadow-sweep",
        "cron": "*/10 * * * *"
      },
      "circuit-breaker-tick": {
        "endpoint": "/internal/scheduler/breaker-tick",
        "cron": "*/3 * * * *"
      },
      "effectiveness-recompute": {
        "endpoint": "/internal/scheduler/effectiveness-recompute",
        "cron": "0 */2 * * *"
      },
      "event-store-compaction": {
        "endpoint": "/internal/scheduler/compaction",
        "cron": "0 4 * * *"
      },
      "briefing-prepare": {
        "endpoint": "/internal/scheduler/briefing-prepare",
        "cron": "0 * * * *"
      },
      "rollback-window-sweep": {
        "endpoint": "/internal/scheduler/rollback-sweep",
        "cron": "0 5 * * *"
      },
      "seed-templates-on-install": {
        "endpoint": "/internal/scheduler/seed-templates"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "EDICT2077_dev"
  }
}
