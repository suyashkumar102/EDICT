{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "edict2077",
  "server": {
    "dir": "distribution/server",
    "entry": "Bootstrap.cjs"
  },
  "permissions": {
    "reddit": {
      "enable": true
    },
    "redis": true,
    "http": {
      "enable": true,
      "domains": ["api.openai.com", "generativelanguage.googleapis.com"]
    }
  },
  "settings": {
    "global": {
      "compilerProvider": {
        "type": "select",
        "label": "Compiler provider",
        "options": [
          {
            "label": "OpenAI GPT (recommended)",
            "value": "openai"
          },
          {
            "label": "Gemini Google (free tier)",
            "value": "gemini"
          }
        ],
        "defaultValue": "openai",
        "helpText": "Set the matching API key below."
      },
      "openaiApiKey": {
        "type": "string",
        "label": "OpenAI API key (sk-...)",
        "isSecret": true,
        "helpText": "Set after first upload: npm run secret:openai"
      },
      "geminiApiKey": {
        "type": "string",
        "label": "Gemini API key (AIza...)",
        "isSecret": true,
        "helpText": "Set with: npm run secret:gemini"
      },
      "compilerModel": {
        "type": "select",
        "label": "Compiler model",
        "options": [
          {
            "label": "gpt-5.4-mini OpenAI recommended",
            "value": "gpt-5.4-mini"
          },
          {
            "label": "gpt-5.4-nano OpenAI cheapest",
            "value": "gpt-5.4-nano"
          },
          {
            "label": "gpt-5.4 OpenAI cautious",
            "value": "gpt-5.4"
          },
          {
            "label": "gemini-2.5-flash Google fast",
            "value": "gemini-2.5-flash"
          },
          {
            "label": "gemini-2.5-flash-lite Google cheapest",
            "value": "gemini-2.5-flash-lite"
          },
          {
            "label": "gemini-2.5-pro Google cautious",
            "value": "gemini-2.5-pro"
          }
        ],
        "defaultValue": "gemini-2.5-flash",
        "helpText": "Match model to provider."
      },
      "compilerVerbosity": {
        "type": "select",
        "label": "Compiler ambiguity tolerance",
        "options": [
          {
            "label": "Strict",
            "value": "strict"
          },
          {
            "label": "Balanced",
            "value": "balanced"
          },
          {
            "label": "Permissive",
            "value": "permissive"
          }
        ],
        "defaultValue": "balanced"
      }
    },
    "subreddit": {
      "sandboxMode": {
        "type": "boolean",
        "label": "Kill switch (log only, never act)",
        "defaultValue": true
      },
      "adaptiveShadow": {
        "type": "boolean",
        "label": "Adaptive shadow auto-promote",
        "defaultValue": true
      },
      "shadowConfidenceThreshold": {
        "type": "number",
        "label": "Shadow promote threshold (0-1)",
        "validationEndpoint": "/internal/validate/confidence",
        "defaultValue": 0.92
      },
      "shadowMinObservations": {
        "type": "number",
        "label": "Min observations before promote",
        "validationEndpoint": "/internal/validate/observations",
        "defaultValue": 25
      },
      "shadowMaxHours": {
        "type": "number",
        "label": "Max shadow duration (hours)",
        "validationEndpoint": "/internal/validate/duration",
        "defaultValue": 72
      },
      "perRuleActionCeiling": {
        "type": "number",
        "label": "Per-rule action ceiling per hour",
        "validationEndpoint": "/internal/validate/ceiling",
        "defaultValue": 50
      },
      "subwideActionCeiling": {
        "type": "number",
        "label": "Subreddit action ceiling per hour",
        "validationEndpoint": "/internal/validate/ceiling",
        "defaultValue": 200
      },
      "rolloutPercent": {
        "type": "number",
        "label": "Staged rollout percent (0-100)",
        "validationEndpoint": "/internal/validate/rollout",
        "defaultValue": 100
      },
      "consensusRequired": {
        "type": "select",
        "label": "Mod consensus for high-impact rules",
        "options": [
          {
            "label": "Off",
            "value": "off"
          },
          {
            "label": "Risky-only",
            "value": "risky"
          },
          {
            "label": "Strict",
            "value": "strict"
          }
        ],
        "defaultValue": "risky"
      },
      "rollbackWindowDays": {
        "type": "number",
        "label": "Rollback window (days)",
        "validationEndpoint": "/internal/validate/window",
        "defaultValue": 30
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "EDICT - Open Command Center",
        "description": "Active rules and audit.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/open-command-center"
      },
      {
        "label": "EDICT - Compose new rule",
        "description": "Write a rule in plain English.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/compose-edict"
      },
      {
        "label": "EDICT - Activate LIVE",
        "description": "Activate latest draft in LIVE phase.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/activate-latest-live"
      },
      {
        "label": "EDICT - Reverse this decision",
        "description": "Restore post/comment.",
        "forUserType": "moderator",
        "location": ["post", "comment"],
        "endpoint": "/internal/menu/reverse-decision"
      },
      {
        "label": "EDICT - Explain this decision",
        "description": "Show rule clauses that fired.",
        "forUserType": "moderator",
        "location": ["post", "comment"],
        "endpoint": "/internal/menu/explain-decision"
      },
      {
        "label": "EDICT - Run What-If",
        "description": "Replay a rule against the last 30 days of post history.",
        "forUserType": "moderator",
        "location": ["subreddit"],
        "endpoint": "/internal/menu/open-what-if"
      }
    ]
  },
  "forms": {
    "composeForm": "/internal/form/compose-submit",
    "clarifyForm": "/internal/form/clarify-submit",
    "activateForm": "/internal/form/activate-submit",
    "whatIfForm": "/internal/form/whatif-submit",
    "consensusForm": "/internal/form/consensus-vote",
    "galleryForm": "/internal/form/gallery-import",
    "commandCenterAction": "/internal/menu/command-center-action",
    "reverseForm": "/internal/form/reverse-submit"
  },
  "triggers": {
    "onPostSubmit": "/internal/trigger/post-submitted",
    "onCommentSubmit": "/internal/trigger/comment-submitted",
    "onPostReport": "/internal/trigger/post-reported",
    "onCommentReport": "/internal/trigger/comment-reported",
    "onPostFlairUpdate": "/internal/trigger/flair-changed",
    "onAppInstall": "/internal/trigger/app-installed",
    "onAppUpgrade": "/internal/trigger/app-upgraded"
  },
  "scheduler": {
    "tasks": {
      "shadow-promotion-sweep": {
        "endpoint": "/internal/scheduler/shadow-sweep",
        "cron": "*/10 * * * *"
      },
      "circuit-breaker-tick": {
        "endpoint": "/internal/scheduler/breaker-tick",
        "cron": "*/3 * * * *"
      },
      "effectiveness-recompute": {
        "endpoint": "/internal/scheduler/effectiveness-recompute",
        "cron": "0 */2 * * *"
      },
      "event-store-compaction": {
        "endpoint": "/internal/scheduler/compaction",
        "cron": "0 4 * * *"
      },
      "briefing-prepare": {
        "endpoint": "/internal/scheduler/briefing-prepare",
        "cron": "0 * * * *"
      },
      "rollback-window-sweep": {
        "endpoint": "/internal/scheduler/rollback-sweep",
        "cron": "0 5 * * *"
      },
      "seed-templates-on-install": {
        "endpoint": "/internal/scheduler/seed-templates"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "EDICT2077_dev"
  }
}
