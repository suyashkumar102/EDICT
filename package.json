{
  "name": "edict2077",
  "version": "0.0.0",
  "description": "English-Declared, Inspected, Compiled, Traced. Reddit moderation rules in plain language — multi-clause, version-controlled, adaptively safe.",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.2.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "devvit playtest",
    "build": "vite build",
    "upload": "devvit upload",
    "publish": "devvit publish",
    "publish:public": "devvit publish --public",
    "logs": "devvit logs",
    "verify": "vitest run",
    "verify:watch": "vitest",
    "verify:coverage": "vitest run --coverage",
    "verify:devvit": "vitest run --config vitest.devvit.config.ts",
    "verify:property": "vitest run tests/property",
    "verify:architecture": "depcruise --config tooling/dependency-cruiser.config.cjs source",
    "acceptance": "tsx tooling/Acceptance.ts",
    "doctor": "tsx tooling/Doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run typecheck && npm run lint && npm run format:check && npm run verify && npm run verify:architecture && npm run acceptance && npm run doctor",
    "preflight": "tsx tooling/Preflight.ts",
    "replay": "tsx tooling/EventReplay.ts",
    "seed": "tsx tooling/SeedTemplates.ts",
    "compile:smoketest": "tsx tooling/CompilerSmoketest.ts",
    "secret:openai": "devvit settings set openaiApiKey",
    "secret:gemini": "devvit settings set geminiApiKey",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@devvit/public-api": "0.12.23",
    "@devvit/web": "0.12.23",
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@devvit/start": "0.12.23",
    "@devvit/test": "0.12.23",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "dependency-cruiser": "^17.0.0",
    "devvit": "0.12.23",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "lefthook": "^1.13.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.7",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  }
}
