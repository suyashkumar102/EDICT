# EDICT environment variables (local tooling only).
# Devvit production reads OpenAI key from `devvit settings set openaiApiKey` — see README.

# Required for `npm run compile:smoketest --provider openai` and local replay tooling.
OPENAI_API_KEY=sk-replace-me

# Required for `npm run compile:smoketest -- --provider gemini`.
# Free-tier keys are issued by https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-replace-me

# Optional: override the compiler model for local smoketests.
EDICT_COMPILER_MODEL=gpt-5.4-mini

# Optional: subreddit name used by `npm run dev` (devvit playtest).
EDICT_DEV_SUBREDDIT=EDICTplayground
